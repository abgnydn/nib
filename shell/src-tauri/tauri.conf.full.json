{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nib",
  "version": "2.0.0",
  "identifier": "app.nib",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Nib",
        "label": "main",
        "width": 920,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/Qwen3-0.6B-Q4_K_M.gguf",
      "resources/qwen2.5-1.5b-instruct-q4_k_m.gguf",
      "resources/nib-faithful-f16.gguf",
      "resources/qvac/*",
      "icons/tray-icon.png",
      "icons/tray-icon@2x.png"
    ],
    "category": "Productivity",
    "shortDescription": "Nib — local-first grammar assistant (Full)",
    "longDescription": "Nib Full edition. Ships LFM2.5-350M (fast/light, default) and Nib-Faithful (Qwen 2.5-1.5B base + RSFT LoRA adapter for faithful rewrites — 88.9% on our held-out eval, up from 64.4% for the stock base) pre-bundled. Pick your model in Settings without downloading anything.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
