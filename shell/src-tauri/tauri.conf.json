{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nib",
  "version": "2.0.0",
  "identifier": "app.nib",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Nib",
        "label": "main",
        "width": 920,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/Qwen3-0.6B-Q4_K_M.gguf",
      "resources/qvac/*",
      "icons/tray-icon.png",
      "icons/tray-icon@2x.png"
    ],
    "category": "Productivity",
    "shortDescription": "Nib — local-first grammar assistant",
    "longDescription": "Nib is a local-first grammar and writing assistant for macOS. Combines a fast Harper rule engine with the LiquidAI LFM2.5-350M LLM, both running entirely on-device. Checking and rewrites make zero network calls; the network is used only for optional model downloads and strictly opt-in cloud training.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
